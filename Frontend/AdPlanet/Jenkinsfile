pipeline {
    agent any
    
    environment {
        IMAGE        = 'myorg/app-frontend:latest'
        COMPOSE_DIR  = '/opt/app/compose'
        PROJECT_NAME = 'app'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Check GitLab Info') {
            steps {
                sh '''
                    echo "gitlabActionType=$gitlabActionType"
                    echo "gitlabBranch=$gitlabBranch"
                    echo "gitlabMergeRequestState=$gitlabMergeRequestState"
                '''
            }
        }
        
        stage('Build Docker image') {
            steps {
                script {
                    updateGitlabCommitStatus name: 'docker-build', state: 'pending'
                    try {
                        withCredentials([file(credentialsId: 'adplanet-frontend-env-file', variable: 'ENV_FILE')]) {
                            dir('Frontend/AdPlanet') {
                                sh '''
                                    set -eu
                                    set -a
                                    . "${ENV_FILE}"
                                    set +a
                                    echo "DEBUG >>> VITE_SSAFY_CLIENT_ID=$VITE_SSAFY_CLIENT_ID"
                                    echo "DEBUG >>> VITE_SSAFY_REDIRECT_URI=$VITE_SSAFY_REDIRECT_URI"
                                    echo "DEBUG >>> VITE_SSAFY_OAUTH_URL=$VITE_SSAFY_OAUTH_URL"
                                    echo "DEBUG >>> VITE_API_BASE_URL=$VITE_API_BASE_URL"
                                    docker build \
                                        --build-arg VITE_SSAFY_CLIENT_ID="${VITE_SSAFY_CLIENT_ID}" \
                                        --build-arg VITE_SSAFY_REDIRECT_URI="${VITE_SSAFY_REDIRECT_URI}" \
                                        --build-arg VITE_SSAFY_OAUTH_URL="${VITE_SSAFY_OAUTH_URL}" \
                                        --build-arg VITE_API_BASE_URL="${VITE_API_BASE_URL}" \
                                        -t ${IMAGE} .
                                '''
                            }
                        }
                        updateGitlabCommitStatus name: 'docker-build', state: 'success'
                    } catch (Exception e) {
                        updateGitlabCommitStatus name: 'docker-build', state: 'failed'
                        throw e
                    }
                }
            }
        }
        
        stage('Deploy frontend') {
            when {
                expression { env.gitlabActionType == 'PUSH' }
            }
            steps {
                script {
                    updateGitlabCommitStatus name: 'deploy', state: 'pending'
                    try {
                        withCredentials([file(credentialsId: 'adplanet-frontend-env-file', variable: 'ENV_FILE')]) {
                            sh """
                                set -eux
                                cd ${COMPOSE_DIR}
                                echo "DEBUG >>> PROJECT_NAME=${PROJECT_NAME}"
                                env | grep VITE_ || true
                                docker compose down || true
                                docker image prune -f || true
                                docker compose -p ${PROJECT_NAME} -f base.yml -f frontend.yml up -d --remove-orphans --wait web
                            """
                        }
                        updateGitlabCommitStatus name: 'deploy', state: 'success'
                    } catch (Exception e) {
                        updateGitlabCommitStatus name: 'deploy', state: 'failed'
                        throw e
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo '✅ 프론트엔드 배포 성공!'
            script {
                if (env.gitlabActionType == 'PUSH') {
                    sh "docker compose -p ${PROJECT_NAME} -f ${COMPOSE_DIR}/base.yml -f ${COMPOSE_DIR}/frontend.yml ps"
                }
                updateGitlabCommitStatus name: 'pipeline', state: 'success'
            }
        }
        failure {
            echo '❌ 프론트엔드 배포 실패'
            script {
                if (env.gitlabActionType == 'PUSH') {
                    sh "docker compose -p ${PROJECT_NAME} -f ${COMPOSE_DIR}/base.yml -f ${COMPOSE_DIR}/frontend.yml logs --tail=100 || true"
                }
                updateGitlabCommitStatus name: 'pipeline', state: 'failed'
            }
        }
    }
}